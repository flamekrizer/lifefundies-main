rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'asmitsharma895@gmail.com' ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    function isMentor() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentor';
    }

    function isGuideOwner(guideId) {
      return signedIn()
        && request.auth.uid == guideId
        && isMentor();
    }

    function canManageGuideSlot(guideId) {
      return isAdmin() || isGuideOwner(guideId);
    }

    // Mentor profiles are public (Mentors page + landing work without login).
    // Signed-in users can read their own doc; admins can read all users.
    match /users/{userId} {
      allow read: if resource.data.role == 'mentor' ||
                  (signedIn() && request.auth.uid == userId) ||
                  isAdmin();
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && (
                      request.resource.data.role in ['user', 'mentor'] ||
                      (
                        request.resource.data.role == 'admin' &&
                        request.auth.token.email == 'asmitsharma895@gmail.com'
                      )
                    );
      allow update: if signedIn()
                    && (
                      isAdmin() ||
                      (
                        request.auth.uid == userId &&
                        request.resource.data.role == resource.data.role
                      )
                    );
    }

    // Guides - Public read, restricted write
    match /guides/{guideId} {
      allow read: if true;
      allow write: if isAdmin() || isGuideOwner(guideId);

      // Slots sub-collection
      match /slots/{slotId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isGuideOwner(guideId);
      }
    }

    // Top-level guide_slots collection
    match /guide_slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.guideId is string
                    && canManageGuideSlot(request.resource.data.guideId);
      allow update, delete: if resource.data.guideId is string
                            && request.resource.data.guideId == resource.data.guideId
                            && canManageGuideSlot(resource.data.guideId);
    }

    // Bookings - User can read their own, write to create
    match /bookings/{bookingId} {
      allow read: if request.auth != null && 
                  (request.auth.uid == resource.data.userId || 
                   request.auth.uid == resource.data.guideId);
      allow create: if request.auth != null && 
                    request.auth.uid == request.resource.data.userId;
      allow update: if signedIn()
    && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.guideId ||
        isAdmin()
    );
    }

    // Sessions - User and guide can read/write their sessions
    match /sessions/{sessionId} {
      allow read: if request.auth != null &&
                  (request.auth.uid == resource.data.userId || 
                   request.auth.uid == resource.data.guideId);
      allow write: if signedIn()
    && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.guideId ||
        isAdmin()
    );
      
      // Messages sub-collection
      match /messages/{messageId} {
       allow read, create: if signedIn()
    && (
        request.auth.uid ==
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId
        ||
        request.auth.uid ==
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.guideId
        ||
        isAdmin()
    );
      }
    }

    // Payments - User can read their own payments
    match /payments/{paymentId} {
      allow read: if signedIn()
    && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
    );
      allow create: if signedIn();
    }

    // Notifications - User can read their own
    match /notifications/{notificationId} {
      allow read: if request.auth != null && 
                  request.auth.uid == resource.data.userId;
      allow create: if true; // System can create notifications
      allow update: if request.auth != null &&
                    request.auth.uid == resource.data.userId &&
                    request.resource.data.userId == resource.data.userId;
    }

    // Community forum - public read, authenticated write.
    // Authenticated includes Firebase anonymous users.
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    match /community_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // Mentor reviews - public read, authenticated write.
    match /mentor_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.sessionId is string
                    && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
                    && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'completed'
                    && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.guideId == request.resource.data.mentorId;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

  }
}
